# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요. (.env는 GitHub에 올리지 않음)

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# 교육기관(코디세이 등)에서 받은 키라면 안내받은 base URL을 넣기. OpenAI 공식 키면 비워 두기
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# 코디세이 예: OPENAI_BASE_URL=https://copa.codyssey.kr/v1, OPENAI_MODEL=gpt-5.4-mini, OPENAI_MAX_TOKENS=1500
OPENAI_MAX_TOKENS=500
CHAT_HISTORY_LIMIT=10

# --- Firebase (둘 중 하나만) ---
# 로컬: 다운받은 서비스 계정 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# 배포(Render): 키 JSON 전체를 한 줄로 붙여넣기
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Firebase 없이 화면/흐름만 테스트할 때 ---
# USE_MEMORY_DB=true

# --- CORS (쉼표 구분, 끝에 / 없이) ---
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080
